  OUTRO
}

model Empreendimento {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Sempre vinculado a uma empresa (cliente)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name                 String
  type                 String? // obra, expansão, planta, licitação...
  location             String?
  estimatedValue       Decimal?  @db.Decimal(14, 2)
  phase                String? // estudo, projeto, licitação, execução...
  expectedDecisionDate DateTime?
  status               String    @default("ATIVO") // ATIVO | STANDBY | ENCERRADO
  notes                String?
  customFields         Json      @default("{}")
  createdById          String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts Lead[]
  deals    Deal[]
  tasks    Task[]
  roadmaps CommercialRoadmap[]

