// NOTIFICATIONS
// ============================================

enum NotificationType {
  TASK_DUE
  TASK_OVERDUE
  LEAD_ASSIGNED
  AUTOMATION_ERROR
  PAYMENT_FAILED
  SUBSCRIPTION_EXPIRING
  DEAL_AT_RISK
  CONTRACT_EXPIRING
  CLIENT_FOLLOWUP
  MANAGER_TRIGGER
  MULTI_SALE_CREATED
  APPROVAL_REQUEST
  APPROVAL_DECIDED
  PROPOSAL_SIGNED
  ATESTADO_PENDENCIA_DUE
  ATESTADO_PENDENCIA_OVERDUE
  ATESTADO_ANALISE_CONCLUIDA
  ATESTADO_RT_DESLIGADO
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Notification {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  title    String
  message  String
  status   NotificationStatus @default(UNREAD)
  link     String?
  metadata Json?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([tenantId, userId])
  @@index([tenantId, userId, status])
  @@index([createdAt])
}

// ============================================
// REPORTS
// ============================================

enum ReportType {
  LEADS
  SALES
  AUTOMATIONS
  TASKS
  CUSTOM
}

model Report {
  id          String @id @default(uuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("ReportCreator", fields: [createdById], references: [id])

  name        String
  description String?
  type        ReportType @default(CUSTOM)
  config      Json       @default("{}") // widgets, schedule, filters, shareSettings

  createdAt DateTime @default(now())
