// ============================================
// TIMES & GOVERNANÇA (Upgrade RD P1)
// ============================================
// Camada ADITIVA e fail-closed: sem Team/PermissionProfile atribuído a um user,
// TODA rota se comporta EXATAMENTE como hoje (defaults do baseRole).

model Team {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  // Líder da equipe (opcional; FK SetNull para não destruir a equipe se o user sai).
  leaderId String?
  leader   User?   @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members User[] @relation("TeamMembers")
  goals   Goal[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("teams")
}

model PermissionProfile {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  // 4 builtins por tenant (1 por baseRole) — imutáveis (não deletáveis/renomeáveis).
  isBuiltin   Boolean  @default(false)
  // Papel do qual o perfil herda os defaults (fail-closed em erro/ausência).
  baseRole    UserRole
  // Overrides booleanos por capability; ausente = herda o default do baseRole.
  capabilities Json @default("{}")
  // { deals, companies, contacts: PROPRIA | EQUIPE | GERAL }
  visibility   Json @default("{}")
  // { export, bulk, delete: bool }
  requireApprovalFor Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("permission_profiles")
}

enum ApprovalType {
  EXPORT
  BULK
  DELETE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
}

model ApprovalRequest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type   ApprovalType
  status ApprovalStatus @default(PENDING)

  requestedById String
  // Dados para reexecutar a ação ao aprovar (entity, filtros/ids, formato…).
  payload Json
  // Texto legível ("Exportar 340 leads (CSV)").
  summary String

  reason      String?
  decidedById String?
  decidedAt   DateTime?
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@map("approval_requests")
}

// ============================================
// DOCUMENTOS & INTEGRAÇÕES EXTERNAS (Upgrade RD P2)
// (arquivos/anexos, propostas + assinatura, integrações plugáveis gated)
// Camada ADITIVA: sem credencial de provedor, assinatura/telefonia ficam
// ocultas e os endpoints respondem "não configurado" (gating gracioso).
// ============================================

enum SignatureStatus {
  NONE
  SENT
  VIEWED
  SIGNED
  REFUSED
  EXPIRED
}

enum IntegrationKind {
  SIGNATURE
  PHONE
}

// Anexo (metadados). Os bytes ficam em AttachmentBlob (provider "db") ou no
// objeto S3-compatível (provider "s3", gated por STORAGE_S3_*). storageKey liga
// o metadado ao blob/objeto. Soft-delete integra a Lixeira (P1).
model Attachment {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  mimeType        String
  size            Int // bytes
  storageProvider String    @default("db") // "db" | "s3"
  storageKey      String // db: id do AttachmentBlob; s3: object key
  dealId          String? // vínculo opcional
  companyId       String?
  leadId          String? // vínculo opcional a lead (atividades de lead)
  interactionId   String? // vínculo opcional à atividade (Reunião/Ligação)
  source          String    @default("UPLOAD") // UPLOAD | PROPOSAL | MEETING (áudio de reunião, P3)
  uploadedById    String?
  deletedAt       DateTime? // soft-delete (integra Lixeira P1)
  createdAt       DateTime  @default(now())

  proposal Proposal? // 1:1 quando source=PROPOSAL

  // IA de reuniões (P3) — interações cujo áudio é este anexo (source=MEETING).
  audioInteractions Interaction[] @relation("InteractionAudio")

  @@index([tenantId, dealId])
  @@index([tenantId, companyId])
  @@index([tenantId, leadId])
  @@index([tenantId, interactionId])
  @@index([tenantId, deletedAt])
  @@map("attachments")
}

// Blob separado para não carregar bytes em listas de metadados.
model AttachmentBlob {
  id   String @id @default(uuid())
  data Bytes  @map("data")

  @@map("attachment_blobs")
}

model ProposalTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  bodyHtml    String // rich HTML com variáveis {{...}} + marcador de tabela de itens
  isDefault   Boolean  @default(false)
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proposals Proposal[]

  @@index([tenantId])
  @@map("proposal_templates")
}

model Proposal {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealId              String
  templateId          String?
  template            ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  version             Int // incremental por deal
  attachmentId        String            @unique // o PDF gerado (Attachment source=PROPOSAL)
  attachment          Attachment        @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  totalValue          Decimal?          @db.Decimal(12, 2)
  signatureStatus     SignatureStatus   @default(NONE) // NONE|SENT|VIEWED|SIGNED|REFUSED|EXPIRED
  signatureEnvelopeId String? // id no provedor de assinatura
  createdById         String?
  createdAt           DateTime          @default(now())

  @@index([tenantId, dealId])
  @@index([tenantId, signatureEnvelopeId])
  @@map("proposals")
}

// Integrações por tenant (credencial encrypted; gated). Uma config por kind.
model IntegrationConfig {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      IntegrationKind // SIGNATURE | PHONE
  provider  String // "zapsign" | "twilio"
  config    Json // encrypted (apiKey, webhookSecret, accountSid, authToken, ...)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([tenantId, kind])
  @@index([tenantId])
  @@map("integration_configs")
}

