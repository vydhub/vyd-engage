// Função comercial (interna) responsável por um passo do playbook. Mapeada a
// pessoas reais ao aplicar o playbook. NÃO altera papéis de acesso (UserRole).
enum CommercialFunction {
  SDR
  CLOSER
  PRE_VENDAS
