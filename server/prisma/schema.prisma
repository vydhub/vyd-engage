model DealProduct {
  id        String @id @default(uuid())
  dealId    String
  productId String
  quantity  Float  @default(1)
  unitPrice Float
  discount  Float  @default(0)

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([dealId])
  @@map("deal_products")
}

model Goal {
  id            String   @id @default(uuid())
  tenantId      String
  // Meta individual (userId) OU meta de equipe (teamId) — exatamente um.
  // Exclusividade validada no service; ambos nullable no schema para permitir
  // metas de equipe (Upgrade RD P1). Sem teamId, comportamento == hoje.
  userId        String?
  teamId        String?
  month         Int
  year          Int
  targetRevenue Float    @default(0)
  targetDeals   Int      @default(0)
  targetLeads   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, month, year])
  @@unique([tenantId, teamId, month, year])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, teamId])
  @@map("goals")
}

model DealStageHistory {
  id        String    @id @default(uuid())
  dealId    String
  stage     String
  enteredAt DateTime  @default(now())
  exitedAt  DateTime?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_stage_history")
}

model StageTaskTemplate {
  id             String   @id @default(uuid())
  tenantId       String
  funnelColumnId String
  taskTitle      String
  dueDaysFromNow Int      @default(3)
  priority       String   @default("MEDIUM")
  assignToOwner  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  funnelColumn FunnelColumn @relation(fields: [funnelColumnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([funnelColumnId])
  @@map("stage_task_templates")
}

// ============================================
// IMPORT PRO (Data Migration)
// ============================================

enum ImportType {
  LEADS
  DEALS
  INTERACTIONS
  COMPANIES
  ATESTADOS
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  ROLLED_BACK
}

model ImportBatch {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  type         ImportType
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  importedRows Int          @default(0)
  errorRows    Int          @default(0)
  skippedRows  Int          @default(0)
  errorLog     Json?
  rolledBackAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId, createdAt])
  @@map("import_batches")
}

// ============================================
// EMAIL CAMPAIGNS
// ============================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  OPENED
  CLICKED
  UNSUBSCRIBED
  BOUNCED
  ERROR
}

enum CampaignEventType {
  OPENED
  CLICKED
  BOUNCED
  UNSUBSCRIBED
}

model Campaign {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name   String
  status CampaignStatus @default(DRAFT)

  // Sender
  fromName  String?
  fromEmail String?
  // Email config (provider) used to send — references EmailConfig.id
  configId  String?

  // Content
  subject String @default("")
  // Body as Block[] (text|image|button|divider|spacer) — see shared contract
  blocks  Json   @default("[]")

  // Audience segmentation filters (status/tag/responsavel/source/score/lastInteraction/no-interaction)
  audienceFilters Json @default("{}")

  // Scheduling
  scheduledAt DateTime?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients CampaignRecipient[]
  events     CampaignEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenantId   String
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Public token for open/click/unsubscribe tracking (unique per recipient)
  token String @unique

  // Denormalized recipient identity (snapshot at send time)
  email String
  name  String?

  status CampaignRecipientStatus @default(PENDING)

  // Per-recipient delivery bookkeeping (edge case: max 3 retries)
  errorCount Int       @default(0)
  lastError  String?
  sentAt     DateTime?
  openedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CampaignEvent[]

  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@index([tenantId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

model CampaignEvent {
  id          String            @id @default(uuid())
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  tenantId    String
  leadId      String

  type CampaignEventType
  // Original URL for CLICKED events
  url  String?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([campaignId, type])
  @@index([recipientId])
  @@index([campaignId, type, createdAt])
  @@map("campaign_events")
}

// ============================================
// DEEP RESEARCH (Pesquisa Profunda)
//
// Paste-in flow (v1): o usuário edita um prompt-modelo, roda no ChatGPT
// (Deep Research) manualmente e cola o markdown de volta, que é renderizado
// como um site estilizado no frontend. `status`/`reportMeta` já preveem a
// futura integração assíncrona com a OpenAI Deep Research API.
// ============================================

enum DeepResearchStatus {
  DRAFT // criada; prompt sendo montado; sem markdown ainda
  RESEARCHING // (futuro) job da API rodando; em v1 = aguardando colar resultado
  COMPLETED // markdown colado/recebido e renderizável
  FAILED // (futuro) job da API falhou
}

model DeepResearchTemplate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String // "Empresa", "Segmento"
  description String?
  // Corpo do prompt com placeholders no formato [EMPRESA]
  promptBody  String

  // Template semente (não deletável pela UI); re-seed idempotente
  isBuiltin   Boolean @default(false)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  researches DeepResearch[]

  @@index([tenantId])
  @@index([tenantId, isBuiltin])
  @@map("deep_research_templates")
}

model DeepResearch {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String?
  title       String

  // Desdobramento comercial — empresa-alvo (opcional, para semear um roadmap)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Template de origem (snapshot do prompt final fica em promptUsed)
  templateId String?
  template   DeepResearchTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Prompt final com placeholders resolvidos + valores preenchidos
  promptUsed String @default("")
  variables  Json   @default("{}") // { "EMPRESA": "ACME" }

  status DeepResearchStatus @default(DRAFT)

  // Markdown bruto colado do ChatGPT (já limpo de marcadores no save)
  reportMarkdown String?
  // { sources: string[], generatedAt?: string, charCount?: number }
  reportMeta     Json?

  // Integração com a OpenAI Deep Research API (modo background)
  providerResponseId String? // id do response da OpenAI
  providerError      String?
  requestedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commercialRoadmaps CommercialRoadmap[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status, providerResponseId])
  @@index([tenantId, companyId])
  @@map("deep_research")
}

