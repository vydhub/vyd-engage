  PENDENTE_EXTRACAO
  OK
  ILEGIVEL
}

enum ConcorrenciaStatus {
  RASCUNHO
  ANALISANDO
  CONCLUIDA
  ARQUIVADA
}

enum ExigenciaAcervo {
  OPERACIONAL
  PROFISSIONAL
  INDEFINIDO
}

enum MatchStatus {
