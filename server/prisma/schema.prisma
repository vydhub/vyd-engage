enum TaskType {
  VISITA
  APRESENTACAO
  LIGACAO
  REUNIAO
  EMAIL
  PROPOSTA
  FOLLOW_UP
  PREPARACAO_DOCUMENTO
  VISITA_TECNICA
  OUTRO
}

enum CommercialRoadmapStatus {
  PLANEJAMENTO
  EM_ANDAMENTO
  PROPOSTA
  GANHO
  PERDIDO
  ARQUIVADO
}

enum StakeholderRole {
  DECISOR
  INFLUENCIADOR
  TECNICO
  APROVADOR
  USUARIO
}

enum StakeholderPosture {
  FAVORAVEL
  NEUTRO
